# managed hosting settings
# only .htaccess file config is able to modify so i use it for all settings within allowed modules
#
# LAYOUT in /web/ is flat now: index.html, about-me.html, contact-me.html, gallery.html,
# 404.html, assets/, styles/, js/, lang/, fonts/ and this file — i.e. the contents of src/.
# No SPA fallback any more: every page is a real file, so Apache serves it directly and
# unknown paths get a real 404. The old sk/, en/, ua/ Angular folders are only a rollback
# net — the rules below intercept those addresses before the folders are ever reached.

# rewrite module to handle URL rewriting and redirection
<IfModule mod_rewrite.c>
    # Enable rewrite engine
    RewriteEngine On
    # Set the base path for all subsequent rewrite rules, relative to the document root -> in my case already in /web/
    RewriteBase /

    # block common exploit attempts -> heavy-lifting filter is i believe managed by root configuration
    # no essential to filter wide spectrum of different threats
    # WordPress, PHP, CMS-specific paths,
    RewriteRule ^wp- - [F,L]
    RewriteRule ^wordpress - [F,L]
    RewriteRule \.php$ - [F,L]
    RewriteRule ^admin - [F,L]
    RewriteRule ^login - [F,L]
    RewriteRule ^xmlrpc\.php - [F,L]
    # hidden files and sensitive extensions
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(env|git|svn|htaccess|htpasswd|log|sql|bak)$ - [F,L]

    # block SQL injection, script injection, traversal attempts, block remote file inclusion
    RewriteCond %{QUERY_STRING} (union.*select|insert.*into|delete.*from|drop.*table) [NC,OR]
    RewriteCond %{QUERY_STRING} (<script|javascript:|onerror=|onload=) [NC,OR]
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|/etc/passwd) [NC,OR]
    RewriteCond %{QUERY_STRING} (http://|https://|ftp://) [NC]
    RewriteRule .* - [F,L]

    # block requests without a User-Agent header
    # legitimate browsers always send this, but many automated scanners don't + block known bad bot patterns
    RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
    RewriteCond %{HTTP_USER_AGENT} (semrush|ahrefs|mj12bot|majestic) [NC]
    RewriteRule .* - [F,L]

    # Apache runs this file again after an internal rewrite and for the ErrorDocument
    # (REDIRECT_STATUS is set then). The target is already final: stop.
    RewriteCond %{ENV:REDIRECT_STATUS} !^$
    RewriteRule ^ - [L]

    # Handle social media and tracking parameters
    # CHANGED: the gallery now carries its own query (?type=weddings&subtype=baptism), and the
    # old rule wiped the WHOLE query string — a link shared on Facebook comes back with fbclid
    # appended and would have lost its type. So strip only on the pages that have no params.
    RewriteCond %{QUERY_STRING} (^|&)(fbclid|fb_[^=]*|utm_[^=]*|source|ref)= [NC]
    RewriteRule ^(|index\.html|about-me\.html|contact-me\.html)$ /$1? [R=301,L]

    # Redirect 'www' to non-'www'
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

    # ============================================================
    # OLD ANGULAR ADDRESSES -> new flat ones
    # Google has indexed /sk/gallery/weddings, /en/about-me, /ua/contact-me ... and people
    # have them bookmarked, so they 301 to the new address.
    #
    # One exception: the old home page. The previous .htaccess 301-redirected / to
    # /sk/index.html and browsers CACHE 301s, so a returning visitor still goes straight to
    # /sk/index.html. Redirecting that back to / would ping-pong forever. That one address
    # is served in place instead — same page, old address, no loop.
    # ============================================================

    # old home page: serve the new index.html where the old one stood
    RewriteRule ^(sk|en|ua)(/index\.html)?/?$ /index.html [L]

    # old asset/font addresses (og:image on Facebook still points at /sk/assets/...)
    RewriteRule ^(sk|en|ua)/assets/(.+)$ /assets/$2 [L]
    RewriteRule ^(sk|en|ua)/fonts/(.+)$ /fonts/$2 [L]

    # old routes -> the matching page + query
    RewriteRule ^(sk|en|ua)/about-me/?$   /about-me.html   [R=301,L]
    RewriteRule ^(sk|en|ua)/contact-me/?$ /contact-me.html [R=301,L]
    RewriteRule ^(sk|en|ua)/gallery/babies/(baptism|newborn)/?$ /gallery.html?type=babies&subtype=$2 [R=301,L]
    RewriteRule ^(sk|en|ua)/gallery/babies/?$ /gallery.html?type=babies&subtype=baptism [R=301,L]
    RewriteRule ^(sk|en|ua)/gallery/(weddings|love-story|pregnancy|studio|family|portrait)/?$ /gallery.html?type=$2 [R=301,L]
    RewriteRule ^(sk|en|ua)/gallery/?$ / [R=301,L]
    # anything else that used to live under a language prefix
    RewriteRule ^(sk|en|ua)/.*$ / [R=301,L]

    # No SPA fallback: files are served as they are, missing paths fall through to
    # ErrorDocument below with a real 404 status.

    #notes:
    # F flag: returns 403 Forbidden
    # L flag: Last rule - stop processing further rules if this one matches
    # R=301 flag: Permanent redirect
    # NC flag: Case-insensitive match
</IfModule>

ErrorDocument 404 /404.html

# Module used to assign correct content metadata (Content-Type) to the corresponding content
# selected for HTTP response by mapping file extensions/patterns in the URI to MIME types.
# this metadata is also used in content negotiation
# also this module runs earlier in the processing chain to properly set Content-Type before other modules would act on it
<IfModule mod_mime.c> # mod_mime.c is source file
    AddType application/javascript .js
    AddType text/css .css
    AddType text/html .html
    AddType application/json .json
    AddType application/manifest+json .webmanifest
    AddType image/avif .avif
    AddType image/x-icon .ico
    AddType image/png .png
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>

# headers module to set custom headers in HTTP response
<IfModule mod_headers.c>
    # Content Security Policy (CSP)
    # img-src: gallery photos come from wherever the API points (DigitalOcean now, Scaleway later)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' momentkaph.fra1.cdn.digitaloceanspaces.com; font-src 'self'; connect-src 'self' api.momentkaph.sk; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self';"

    # before CSP frame-ancestors directive
    Header set X-Frame-Options "DENY"

    # X-Content-Type-Options - prevents MIME type sniffing
    # Browsers will trust your Content-Type headers and won't try to guess
    # This prevents attacks where malicious content is disguised as safe files
    Header always set X-Content-Type-Options "nosniff"

    # Referrer-Policy - controls how much information is sent in Referer header
    # 'strict-origin-when-cross-origin' (default) sends full URL for same-origin requests
    # but only the origin for cross-origin requests, protecting user privacy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # HSTS - force HTTPS for 1 year, including subdomains
    # only add "preload" once you're sure and intend to submit to hstspreload.org
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Permissions-Policy - (experimental, low support) controls which browser features your site can use
    # This limits the attack surface by disabling features you don't need
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # CORS based on the requesting origin
    Header set Access-Control-Allow-Origin "https://momentkaph.sk"

    # CHANGED: js/css are NOT content-hashed any more (no build step, files are js/index.js,
    # styles/global.css ...). The Angular rule cached them "1 year, immutable" — with these
    # names that would freeze the old code in every returning browser after a deploy.
    # no-cache = always revalidate; Apache answers a cheap 304 when nothing changed.
    <FilesMatch "\.(html|webmanifest|json|js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # images, icons, fonts - long cache => 31536000 seconds ~ 1 year
    # these rarely change; when one does, give it a new file name
    <FilesMatch "\.(avif|png|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# compress content on-the-fly (transport layer) before sending to client (Content-Encoding: )
# avif/png/woff2 are already compressed formats, no need for further compression
# using BROTLI algorithm (Huffman encoding, LZSS and second-order context modeling)=> br
# alternatively, could use mod_deflate (gzip), but brotli has wide support, so...
<IfModule mod_brotli.c>
    # AddOutputFilterByType assigns a filter to specific MIME types
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json
</IfModule>
