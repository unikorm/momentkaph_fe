{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
